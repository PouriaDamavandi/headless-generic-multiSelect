{
  "name": "react-headless-multiselect",
  "version": "0.1.0",
  "description": "A generic headless React multiselect component with an optional default UI.",
  "type": "module",
  "license": "MIT",
  "author": "Pouria Damavandi",
  "keywords": [
    "react",
    "typescript",
    "multiselect",
    "multi-select",
    "select",
    "headless",
    "combobox",
    "storybook"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "API.md",
    "ACCESSIBILITY.md",
    "BUGS.md",
    "TESTING.md",
    "CONTRIBUTING.md",
    "GIT_CONVENTIONS.md",
    "RELEASE.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:demo && pnpm build:package",
    "build:demo": "tsc -b && vite build --outDir demo-dist",
    "build:package": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "lint": "eslint .",
    "preview": "vite preview --outDir demo-dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepack": "pnpm build:package",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.574.0",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/addon-vitest": "^10.2.10",
    "@storybook/react-vite": "^10.2.10",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.2.10",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.21.1",
    "storybook": "^10.2.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.48.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
